[Unit]
Description=VIVIAN Automotive Assistant
After=sound.target

[Service]
Type=simple
User=cjatkinson
WorkingDirectory=/home/cjatkinson/VIVIANMK18
ExecStartPre=/bin/bash /home/cjatkinson/VIVIANMK18/init_audio.sh
ExecStart=/usr/bin/python3 /home/cjatkinson/VIVIANMK18/main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
